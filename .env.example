FLIGHT_PROVIDER=google

# Protects /api/cron/daily-snapshot from being triggered by anyone but
# Vercel Cron. Generate any random string; Vercel sends it automatically
# as "Authorization: Bearer <value>" once set as a project env var.
CRON_SECRET=

# Provisioned automatically when you add the "Upstash for Redis"
# integration (Vercel dashboard → Storage) to this project — do not set
# these by hand, Vercel injects them. See README "Deploy" section.
#
# Vercel uses one of two naming styles depending on how the store was
# attached; the app reads either, so whichever one you get works:
#   UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#   KV_REST_API_URL        + KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
